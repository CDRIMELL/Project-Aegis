{
  "name": "aegis",
  "version": "0.1.0",
  "private": true,
  "description": "AEGIS - Aerospace Operations & Simulation Platform",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run tauri:dev -w @aegis/desktop",
    "build": "npm run data:build && npm run tauri:build -w @aegis/desktop",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "npm run generate -w @aegis/db --",
    "verify:world": "tsx tools/verify-world.ts",
    "rust:fmt": "cargo fmt --manifest-path apps/desktop/src-tauri/Cargo.toml -- --check",
    "rust:lint": "cargo clippy --manifest-path apps/desktop/src-tauri/Cargo.toml --all-targets -- -D warnings",
    "rust:test": "cargo test --manifest-path apps/desktop/src-tauri/Cargo.toml",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "check:rust": "npm run rust:prepare && npm run rust:fmt && npm run rust:lint && npm run rust:test",
    "ci": "npm run check && npm run check:rust",
    "data:fetch": "tsx packages/ingest/src/node/cli.ts fetch",
    "data:aircraft-specs": "tsx packages/ingest/src/node/cli.ts aircraft-specs",
    "data:import": "tsx packages/ingest/src/node/cli.ts import",
    "rust:prepare": "npm run build -w @aegis/desktop && tsx tools/make-parity-db.ts",
    "data:pack": "tsx packages/ingest/src/node/cli.ts pack",
    "data:install-pack": "tsx packages/ingest/src/node/cli.ts install-pack",
    "verify:reference": "tsx tools/verify-reference.ts",
    "data:basemap": "tsx packages/ingest/src/node/cli.ts basemap",
    "data:build": "npm run data:pack && npm run data:basemap"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.1",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.10.2",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
